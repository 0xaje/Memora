# Memora Environment Configuration
APP_NAME=Memora
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Sibyl Memory Configuration
# Path to the local SQLite database used by Sibyl MemoryClient
SIBYL_DB_PATH=~/.sibyl-memory/memora.db
SIBYL_TENANT_ID=00000000-0000-0000-0000-000000000001
SIBYL_TIER=free
